# Database. Defaults to local SQLite so the API runs with no extra services.
# For Postgres (docker-compose):
#   DATABASE_URL=postgresql+psycopg2://market:market@localhost:5432/market
DATABASE_URL=sqlite:///./data/market.db

# Where raw transcripts / audio get written
DATA_DIR=./data

# AI extraction provider: anthropic | openai | null
# "null" runs a no-op extractor so the pipeline works without any API key.
EXTRACTION_PROVIDER=null
EXTRACTION_API_KEY=
EXTRACTION_MODEL=

# Whisper fallback for videos with no captions. Requires: pip install faster-whisper
ENABLE_WHISPER_FALLBACK=false
WHISPER_MODEL=base

# CORS origins for the dashboard
CORS_ORIGINS=http://localhost:5173

# SEC requires a descriptive User-Agent with a contact address on every request.
SEC_USER_AGENT=AI Market Prediction Data your-email@example.com
# yfinance period shorthand for daily bar history: 1y, 5y, max
PRICE_HISTORY_PERIOD=5y

# Web scraping. Identify honestly; delay is a floor (a site's Crawl-delay wins if longer).
SCRAPER_USER_AGENT=MarketSignalResearch/0.1 (+research contact: you@example.com)
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_MAX_PAGES=500

# Leave blank for open read endpoints (localhost only). Set to require a key.
API_KEY=
