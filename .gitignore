# Secrets — never commit. `.env.example` is the template that does get committed.
.env
.env.local
.env.*.local

# Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# Collected data — regenerated by running the app, and large.
# Delete this line if you deliberately want to ship a seeded database.
backend/data/

# Machine-specific tooling config. launch.json stores absolute paths and a
# platform-specific venv layout (bin/ vs Scripts/), so it cannot be shared —
# the run commands live in README.md instead.
.claude/

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Logs
*.log
